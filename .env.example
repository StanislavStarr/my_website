# Fill in your real domain before publishing (no trailing path).
SITE_URL=
# Enable only on the production domain, then rebuild.
ENABLE_INDEXING=false

# Contact form (https://resend.com → API Keys). Without a verified domain Resend
# can only deliver to the email of your Resend account, which is fine here.
RESEND_API_KEY=
# Where leads arrive (defaults to the address in src/lib/site.ts).
CONTACT_TO=
# Optional, after verifying a domain in Resend: "Portfolio <hello@yourdomain.com>".
CONTACT_FROM=
